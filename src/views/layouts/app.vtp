<header class="navbar sticky-top bg-white flex-md-nowrap p-0" data-bs-theme="light">
    <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-dark" href="/">
        <div class="px-md-3">
            <img src="/assets/images/htd-width-logo-trans-stroke.png" alt="company-logo" class="w-100 h-100" style="object-fit: contain;object-position: left;">
        </div>
    </a> 
    <!-- Right Menu -->
    <div class="ms-auto d-flex align-items-center gap-3 px-md-4 px-2">
        <!-- Notification -->
        @component('vtp-notification')

        <!-- User -->
        @component('vtp-account')

        <!-- Mobile Toggle -->
        <button class="btn btn-transparent btn-burger p-0 d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
            <span class="burger-line"></span>
            <span class="burger-line"></span>
            <span class="burger-line"></span>
        </button>
    </div>
    
</header>
<div class="container-fluid">
    <div class="row">
        <div class="sidebar bg-white border-end">
            <div class="offcanvas-md offcanvas-start bg-white" tabindex="-1" id="sidebarMenu">
                <!-- Mobile Header -->
                <div class="offcanvas-header border-bottom">
                    <h5 class="mb-0 fw-bold">Menu</h5>
                    <button class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu"></button>
                </div>

                <div class="offcanvas-body d-flex flex-column p-3">
                    <!-- MAIN -->
                    <small class="text-uppercase text-secondary fw-semibold px-2 mb-2">
                        Main Menu
                    </small>

                    <ul class="nav nav-pills flex-column gap-2">
                        @for(const menu of menus)
                        <li class="nav-item">
                            @if(menu.children.length)
                            <a class="nav-link d-flex align-items-center vtp-side-menu {{isRouteActive(menu.activeState) ? 'active' : ''}}" data-bs-toggle="collapse" href="#{{menu.name}}" role="button" aria-expanded="false">
                                <i class="bi bi-folder2-open"></i>
                                <span>{{menu.label}}</span>
                                <i class="bi bi-chevron-down ms-auto"></i>
                            </a>
                            <div class="collapse" id="{{menu.name}}">
                                <ul class="nav flex-column submenu">
                                    @for(const children of menu.children)
                                    <li>
                                        <a href="{{children.route}}" class="nav-link" router-link>
                                            <i class="bi bi-dot"></i>
                                            {{children.label}}
                                        </a>
                                    </li>
                                    @endfor
                                </ul>
                            </div>
                            @else
                            <a href="{{menu.route}}" class="nav-link vtp-side-menu {{isRouteActive(menu.activeState) ? 'active' : ''}}" router-link>
                                <i class="{{menu.icon}}"></i>
                                {{menu.label}}
                            </a>
                            @endif
                        </li>
                        @endfor
                    </ul>
                    <hr>
                    <!-- SYSTEM -->
                    <small class="text-uppercase text-secondary fw-semibold px-2 mb-2">
                        System
                    </small>
                    <ul class="nav nav-pills flex-column gap-2 mb-2">
                        @if(isAllowed('users.index'))
                        <li>
                            <a href="/users" class="nav-link vtp-side-menu {{isRouteActive('/users/*') ? 'active' : ''}}" router-link>
                                <i class="bi bi-people"></i>
                                Users
                            </a>
                        </li>
                        @endif

                        @if(isAllowed('roles.index'))
                        <li>
                            <a href="/roles" class="nav-link vtp-side-menu {{isRouteActive('/roles/*') ? 'active' : ''}}" router-link>
                                <i class="bi bi-person-badge"></i>
                                Roles
                            </a>
                        </li>
                        @endif

                        @if(isAllowed('setting'))
                        <li>
                            <a href="/setting" class="nav-link vtp-side-menu {{isRouteActive('/setting') ? 'active' : ''}}" router-link>
                                <i class="bi bi-gear"></i>
                                Settings
                            </a>
                        </li>
                        @endif
                        <li>
                            <a href="javascript:void(0)" class="nav-link text-danger btn-logout">
                                <i class="bi bi-box-arrow-right"></i>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <main class="main-content p-4">
            <section data-vtprouter></section>
        </main>
    </div>
</div>
        